{
  "name": "relay-inspector-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only inspector for Relay normalized stores.",
  "scripts": {
    "dev": "pnpm --filter @relay-inspector/server dev",
    "dev:server": "pnpm --filter @relay-inspector/server dev:server",
    "dev:extension": "pnpm --filter @relay-inspector/extension dev",
    "start": "pnpm --filter @relay-inspector/server start",
    "smoke": "pnpm --filter @relay-inspector/server smoke",
    "relay:check": "pnpm --filter @relay-inspector/core relay:check",
    "test": "pnpm -r test",
    "build": "pnpm --filter @relay-inspector/core build && pnpm --filter @relay-inspector/server build && pnpm --filter @relay-inspector/extension build",
    "build:ui": "pnpm --filter @relay-inspector/server build:ui",
    "build:core": "pnpm --filter @relay-inspector/core build",
    "build:extension": "pnpm --filter @relay-inspector/extension build",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.3"
}
