{
  "name": "@relay-inspector/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "relay-inspector": "./bin.ts"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/index.ts",
    "start": "pnpm --filter @relay-inspector/core build && pnpm run build:ui && tsx bin.ts",
    "smoke": "tsx scripts/e2e-smoke.ts",
    "build": "pnpm run build:ui",
    "build:ui": "vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@relay-inspector/core": "workspace:*",
    "@relay-inspector/ui": "workspace:*",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13"
  }
}
